<?xml version="1.0" encoding="utf-8"?>
<!--
  How much the game's own AI values a Dam. The engine lets the AI build one only on a site ui/dams-sites.js marked
  (a river that floods, no Dam as good on it, tiles of the AI's own a flood would pillage: data/dams-sites.xml), so the
  value can be raised safely: it acts only where the Dam guards something. Unraised, the AI never built a Dam in 60
  turns (u1); at 400 it scored about 1,900 at its site (v1b) against the 3,000-7,000 of what it did build. Value V
  multiplies the AI's score by 1 + V/100 (engine-closed.md, AI data).
-->
<Database>
    <AiListTypes>
        <Row ListType="Dams Site Priority"/>
    </AiListTypes>
    <AiLists>
        <Row ListType="Dams Site Priority" LeaderType="TRAIT_LEADER_MAJOR_CIV" System="ConstructibleBiases"/>
    </AiLists>
    <AiFavoredItems>
        <Row ListType="Dams Site Priority" Item="BUILDING_DAM_ANTIQUITY" Value="3000"/>
        <Row ListType="Dams Site Priority" Item="BUILDING_DAM_EXPLORATION" Value="3000"/>
        <Row ListType="Dams Site Priority" Item="BUILDING_DAM_MODERN" Value="3000"/>
    </AiFavoredItems>
</Database>
