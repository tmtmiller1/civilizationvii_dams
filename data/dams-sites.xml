<?xml version="1.0" encoding="utf-8"?>
<!--
  Dam sites. Each Dam requires the site marker on its tile, so the engine offers it, to the game's own AI as to the
  player, only on a tile ui/dams-sites.js has marked: for an AI, one tile of each river where a Dam guards something
  (the game's AI then decides for itself whether and when to build it there); for the player, the tile of each order.
  The game's AI obeys only the data, and the data cannot say "a river that floods, with no Dam as good on it". The
  marker has no feature class, gives way to other buildings (Removable) and yields exactly what the land beneath it
  yields (data/dams-sites.sql); watched with the Canals marker, runs m1-m7, 2026-09-29.
-->
<Database>
    <Types>
        <Row Type="FEATURE_DAMS_SITE" Kind="KIND_FEATURE"/>
    </Types>
    <Features>
        <Row FeatureType="FEATURE_DAMS_SITE" Name="LOC_FEATURE_DAMS_SITE_NAME" Tooltip="LOC_FEATURE_DAMS_SITE_TOOLTIP" PlacementClass="ONE" PlacementDensity="0" Removable="true"/>
    </Features>
    <Feature_ValidTerrains>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_FLAT"/>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_HILL"/>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_NAVIGABLE_RIVER"/>
    </Feature_ValidTerrains>
    <Feature_ValidBiomes>
        <Row BiomeType="BIOME_DESERT" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_GRASSLAND" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_PLAINS" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_TROPICAL" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_TUNDRA" FeatureType="FEATURE_DAMS_SITE"/>
    </Feature_ValidBiomes>
    <Constructible_RequiredFeatures>
        <Row ConstructibleType="BUILDING_DAM_ANTIQUITY" FeatureType="FEATURE_DAMS_SITE"/>
        <Row ConstructibleType="BUILDING_DAM_EXPLORATION" FeatureType="FEATURE_DAMS_SITE"/>
        <Row ConstructibleType="BUILDING_DAM_MODERN" FeatureType="FEATURE_DAMS_SITE"/>
    </Constructible_RequiredFeatures>
</Database>
