<?xml version="1.0" encoding="utf-8"?>
<!--
  The dam-site marker of 1.3.0, kept only so a save made with 1.3.0 still loads: its markers stay on the map until
  ui/dams-sites.js lifts them and puts back what each replaced. Nothing requires the marker any more; a Dam goes on
  any river tile. It has no feature class and yields exactly what the land beneath it yields (data/dams-sites.sql).
-->
<Database>
    <Types>
        <Row Type="FEATURE_DAMS_SITE" Kind="KIND_FEATURE"/>
    </Types>
    <Features>
        <Row FeatureType="FEATURE_DAMS_SITE" Name="LOC_FEATURE_DAMS_SITE_NAME" Tooltip="LOC_FEATURE_DAMS_SITE_TOOLTIP" PlacementClass="ONE" PlacementDensity="0" Removable="true"/>
    </Features>
    <Feature_ValidTerrains>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_FLAT"/>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_HILL"/>
        <Row FeatureType="FEATURE_DAMS_SITE" TerrainType="TERRAIN_NAVIGABLE_RIVER"/>
    </Feature_ValidTerrains>
    <Feature_ValidBiomes>
        <Row BiomeType="BIOME_DESERT" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_GRASSLAND" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_PLAINS" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_TROPICAL" FeatureType="FEATURE_DAMS_SITE"/>
        <Row BiomeType="BIOME_TUNDRA" FeatureType="FEATURE_DAMS_SITE"/>
    </Feature_ValidBiomes>
</Database>
