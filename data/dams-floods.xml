<?xml version="1.0" encoding="utf-8"?>
<!--
  Flood classes by severity. The base game files all three floods (moderate, major, 1000-year) under CLASS_FLOOD, and
  the only per-settlement protection the engine has, EFFECT_CITY_ADJUST_AVOID_RANDOM_EVENT, is chosen by class. Giving
  the major and the 1000-year flood classes of their own lets each age's Dam hold back a different set:
  Ancient the moderate flood, Medieval the moderate and the major, Modern all three. data/dams-floods.sql moves the two
  events into these classes and keeps every other flood immunity covering all three.
-->
<Database>
    <Types>
        <Row Type="CLASS_DAMS_FLOOD_MAJOR" Kind="KIND_RANDOM_EVENT_CLASS"/>
        <Row Type="CLASS_DAMS_FLOOD_1000_YEAR" Kind="KIND_RANDOM_EVENT_CLASS"/>
    </Types>
    <EventClasses>
        <Row EventClass="CLASS_DAMS_FLOOD_MAJOR"/>
        <Row EventClass="CLASS_DAMS_FLOOD_1000_YEAR"/>
    </EventClasses>
    <!-- Overtopping: a flood bigger than a Dam holds back pillages the Dam itself whenever it reaches the Dam's tile, as
         every flood pillages the base Ancient Bridge; the floods it holds back never do. Here, after the classes
         above exist (the table has a foreign key onto them), and before data/dams-floods.sql copies each CLASS_FLOOD
         row to the two new classes; that copy is INSERT OR IGNORE, so these values stand. -->
    <Constructible_PillageRandomEvents>
        <Row ConstructibleType="BUILDING_DAM_ANTIQUITY" EventClass="CLASS_FLOOD" PercentChance="0"/>
        <Row ConstructibleType="BUILDING_DAM_ANTIQUITY" EventClass="CLASS_DAMS_FLOOD_MAJOR" PercentChance="100"/>
        <Row ConstructibleType="BUILDING_DAM_ANTIQUITY" EventClass="CLASS_DAMS_FLOOD_1000_YEAR" PercentChance="100"/>
        <Row ConstructibleType="BUILDING_DAM_EXPLORATION" EventClass="CLASS_FLOOD" PercentChance="0"/>
        <Row ConstructibleType="BUILDING_DAM_EXPLORATION" EventClass="CLASS_DAMS_FLOOD_MAJOR" PercentChance="0"/>
        <Row ConstructibleType="BUILDING_DAM_EXPLORATION" EventClass="CLASS_DAMS_FLOOD_1000_YEAR" PercentChance="100"/>
        <Row ConstructibleType="BUILDING_DAM_MODERN" EventClass="CLASS_FLOOD" PercentChance="0"/>
        <Row ConstructibleType="BUILDING_DAM_MODERN" EventClass="CLASS_DAMS_FLOOD_MAJOR" PercentChance="0"/>
        <Row ConstructibleType="BUILDING_DAM_MODERN" EventClass="CLASS_DAMS_FLOOD_1000_YEAR" PercentChance="0"/>
    </Constructible_PillageRandomEvents>
</Database>
