<?xml version="1.0" encoding="utf-8"?>
<!--
  Throwaway dev harness for the dams probes. Installed and removed by run-harness.sh; it hijacks
  every launch while present, so never leave it in Mods/. Self-contained: it imports nothing.
-->
<Mod id="dam-harness" version="1" xmlns="ModInfo">
    <Properties>
        <Name>Dam Harness (dev)</Name>
        <Description>Throwaway dev harness. Starts a Play Now game, runs one dams probe, logs [DAM] to UI.log. Remove the folder afterwards.</Description>
        <Authors>Tower</Authors>
        <Package>DamHarness</Package>
        <PackageSortIndex>9999</PackageSortIndex>
        <Version>0.0.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="damh-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions><UIScripts><Item>ui/damh-shell.js</Item></UIScripts></Actions>
        </ActionGroup>
        <ActionGroup id="damh-game" scope="game" criteria="always">
            <Properties><LoadOrder>9000</LoadOrder></Properties>
            <Actions><UIScripts><Item>ui/damh-game.js</Item></UIScripts></Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
