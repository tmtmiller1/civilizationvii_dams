<?xml version="1.0" encoding="utf-8"?>
<!-- E2e (DEPLOY freqmixfloods): major floods 300 times per age to overtop Ancient Dams, a few moderate ones (30) to
     test whether a settlement keeps its immunity while its Dam is pillaged; no 1000-year floods. The game's own pillage
     shares. -->
<Database>
    <RandomEventFrequencies>
        <Update><Where RandomEventType="RANDOM_EVENT_FLOOD_MODERATE"/><Set OccurrencesPerAge="30"/></Update>
        <Update><Where RandomEventType="RANDOM_EVENT_FLOOD_MAJOR"/><Set OccurrencesPerAge="300"/></Update>
        <Update><Where RandomEventType="RANDOM_EVENT_FLOOD_1000_YEAR"/><Set OccurrencesPerAge="0"/></Update>
    </RandomEventFrequencies>
</Database>
