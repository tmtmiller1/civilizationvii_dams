<?xml version="1.0" encoding="utf-8"?>
<!--
  Dams - a Civilization VII mod.
  Three Dam buildings (Antiquity, Exploration, Modern), built through the ordinary production screen on any river
  tile, navigable or minor. A finished Dam yields Food and Production and keeps floods from pillaging its settlement:
  moderate floods from Antiquity, major ones too from Exploration, every flood from the Modern age. Data: the
  buildings, their price, the flood classes, the tech unlocks and the build icon; every rule a player meets is here,
  so it holds for the game's AI and in a network game alike. Script: the Levees (single player only), the drawn dam,
  and lifting the dam-site markers of a 1.3.0 save.
  AffectsSavedGames=0: the data adds types, and the only base rows it changes are the flood classes (major and
  1000-year floods get classes of their own, data/dams-floods.sql), which a save does not record.
-->
<Mod id="tower-dams" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_DAMS_MOD_NAME</Name>
        <Description>LOC_DAMS_MOD_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Package>Dams</Package>
        <PackageSortIndex>100</PackageSortIndex>
        <Version>2.0.2</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
        <Criteria id="antiquity-age-current"><AgeInUse>AGE_ANTIQUITY</AgeInUse></Criteria>
        <Criteria id="exploration-age-current"><AgeInUse>AGE_EXPLORATION</AgeInUse></Criteria>
        <Criteria id="modern-age-current"><AgeInUse>AGE_MODERN</AgeInUse></Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="dams-shell" scope="shell" criteria="always">
            <Actions>
                <UpdateText>
                    <Item>text/en_us/DamsText.xml</Item>
                    <Item locale="de_DE">text/de_de/DamsText.xml</Item>
                    <Item locale="es_ES">text/es_es/DamsText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/DamsText.xml</Item>
                    <Item locale="it_IT">text/it_it/DamsText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/DamsText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/DamsText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/DamsText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/DamsText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/DamsText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/DamsText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/DamsText.xml</Item>
                </UpdateText>
                <ImportFiles><Item>icons/dam_ancient.png</Item><Item>icons/dam_ancient_128.png</Item><Item>icons/dam_ancient_64.png</Item><Item>icons/dam_medieval.png</Item><Item>icons/dam_medieval_128.png</Item><Item>icons/dam_medieval_64.png</Item><Item>icons/dam_modern.png</Item><Item>icons/dam_modern_128.png</Item><Item>icons/dam_modern_64.png</Item></ImportFiles>
                <UpdateIcons><Item>data/dams-icons.xml</Item></UpdateIcons>
                <UIScripts>
                    <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                    <Item>ui/settings-keeper.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="dams-game" scope="game" criteria="always">
            <Properties><LoadOrder>150</LoadOrder></Properties>
            <Actions>
                <UpdateDatabase><Item>data/dams.xml</Item><Item>data/dams-floods.xml</Item><Item>data/dams-effects.xml</Item><Item>data/dams-floods.sql</Item><Item>data/dams-placement.sql</Item><Item>data/dams-sites.xml</Item><Item>data/dams-sites.sql</Item><Item>data/dams-civilopedia.xml</Item></UpdateDatabase>
                <UpdateText>
                    <Item>text/en_us/DamsText.xml</Item>
                    <Item locale="de_DE">text/de_de/DamsText.xml</Item>
                    <Item locale="es_ES">text/es_es/DamsText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/DamsText.xml</Item>
                    <Item locale="it_IT">text/it_it/DamsText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/DamsText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/DamsText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/DamsText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/DamsText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/DamsText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/DamsText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/DamsText.xml</Item>
                </UpdateText>
                <ImportFiles><Item>icons/dam_ancient.png</Item><Item>icons/dam_ancient_128.png</Item><Item>icons/dam_ancient_64.png</Item><Item>icons/dam_medieval.png</Item><Item>icons/dam_medieval_128.png</Item><Item>icons/dam_medieval_64.png</Item><Item>icons/dam_modern.png</Item><Item>icons/dam_modern_128.png</Item><Item>icons/dam_modern_64.png</Item></ImportFiles>
                <UpdateIcons><Item>data/dams-icons.xml</Item></UpdateIcons>
                <!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
                <UIScripts><Item>ui/settings-keeper.js</Item><Item>ui/dams.js</Item><Item>ui/dams-sites.js</Item></UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Tech unlocks live in per-age groups: a node of another age is not in that age's database. -->
        <ActionGroup id="dams-antiquity" scope="game" criteria="antiquity-age-current">
            <Properties><LoadOrder>151</LoadOrder></Properties>
            <Actions><UpdateDatabase><Item>data/dams-antiquity.xml</Item></UpdateDatabase></Actions>
        </ActionGroup>
        <ActionGroup id="dams-exploration" scope="game" criteria="exploration-age-current">
            <Properties><LoadOrder>151</LoadOrder></Properties>
            <Actions><UpdateDatabase><Item>data/dams-exploration.xml</Item></UpdateDatabase></Actions>
        </ActionGroup>
        <ActionGroup id="dams-modern" scope="game" criteria="modern-age-current">
            <Properties><LoadOrder>151</LoadOrder></Properties>
            <Actions><UpdateDatabase><Item>data/dams-modern.xml</Item></UpdateDatabase></Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
